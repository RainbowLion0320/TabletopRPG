{
  "name": "tabletop-rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "scenario:validate": "node scripts/scenario-tools.mjs validate",
    "scenario:build": "node scripts/scenario-tools.mjs build",
    "scenario:docs": "node scripts/scenario-tools.mjs docs",
    "scenario:generate": "node scripts/scenario-tools.mjs generate",
    "scenario:check": "node scripts/scenario-tools.mjs check",
    "precheck": "node scripts/precheck.mjs",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-game.ps1",
    "start:game": "vite --host 127.0.0.1 --port 5273 --strictPort",
    "dev": "vite --host 127.0.0.1",
    "docs:gdd": "node scripts/generate-gdd-html.cjs",
    "build": "npm run scenario:check && tsc -b && vite build",
    "check": "npm test && npm run build",
    "check:full": "npm test && npm run build && npm run test:smoke",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run scenario:check && vitest run",
    "test:watch": "vitest",
    "test:smoke": "playwright test"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "elkjs": "^0.11.1",
    "jsonrepair": "^3.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "ajv": "^8.20.0",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "yaml": "^2.9.0"
  }
}
