<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#211B12</item>
        <item name="colorPrimaryDark">#0D0C0A</item>
        <item name="colorAccent">#C6A663</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#0D0C0A</item>
        <item name="android:statusBarColor">#0D0C0A</item>
        <item name="android:navigationBarColor">#0D0C0A</item>
    </style>
    <style name="AppTheme.NoActionBar" parent="AppTheme" />
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0D0C0A</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
