{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["vite.config.ts", "vite.android.config.ts", "capacitor.config.ts", "scripts/runtime-art.ts", "src/config/aiConfig.ts", "src/config/androidBuildDefaults.ts", "src/types/game.ts"]
}
